{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "producer_job_id": {
          "minLength": 1,
          "title": "Producer Job Id",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "producer_job_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AxisReview": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "revise",
            "fail",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "checked_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Checked Artifacts",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "findings",
        "checked_artifacts"
      ],
      "title": "AxisReview",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "level": {
          "enum": [
            "functional",
            "analytical",
            "simulation",
            "synthesis",
            "hardware"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "conditions",
        "evidence",
        "level"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unverified",
            "needs_human"
          ],
          "title": "Status",
          "type": "string"
        },
        "check": {
          "minLength": 1,
          "title": "Check",
          "type": "string"
        },
        "verified_check_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "title": "Verified Check Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "human_judgment": {
          "title": "Human Judgment",
          "type": "boolean"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limitation"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "check",
        "verified_check_ids",
        "evidence",
        "human_judgment",
        "limitation"
      ],
      "title": "Coverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "minimum": 1,
      "title": "Task Revision",
      "type": "integer"
    },
    "task_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Spec Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "opc.review.v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Review Id",
      "type": "string"
    },
    "review_call_id": {
      "minLength": 1,
      "title": "Review Call Id",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Submission Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "standards": {
      "$ref": "#/$defs/AxisReview"
    },
    "spec": {
      "$ref": "#/$defs/AxisReview"
    },
    "recommended_disposition": {
      "enum": [
        "accept",
        "revise",
        "reject",
        "blocked"
      ],
      "title": "Recommended Disposition",
      "type": "string"
    },
    "conclusion": {
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "accepted_claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Accepted Claims",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "checked_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checked Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "task_id",
    "task_revision",
    "task_spec_sha256",
    "run_id",
    "schema_version",
    "review_id",
    "review_call_id",
    "submission_id",
    "manifest_sha256",
    "standards",
    "spec",
    "recommended_disposition",
    "conclusion",
    "accepted_claims",
    "coverage",
    "unknowns",
    "gaps",
    "checked_manifest_sha256"
  ],
  "title": "ReviewDecisionV02",
  "type": "object"
}
