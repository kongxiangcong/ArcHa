{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "opc.project.v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "protocol_version": {
      "const": "opc.v0.2",
      "title": "Protocol Version",
      "type": "string"
    },
    "control_root": {
      "const": ".opc",
      "title": "Control Root",
      "type": "string"
    },
    "components": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "adapter_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "artifact_store_alias": {
      "const": "artifacts",
      "title": "Artifact Store Alias",
      "type": "string"
    },
    "workspace_store_alias": {
      "const": "workspaces",
      "title": "Workspace Store Alias",
      "type": "string"
    },
    "baseline_policy": {
      "const": "clean_commit_or_explicit_snapshot",
      "title": "Baseline Policy",
      "type": "string"
    },
    "execution_enabled": {
      "title": "Execution Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "display_name",
    "protocol_version",
    "control_root",
    "components",
    "adapter_id",
    "artifact_store_alias",
    "workspace_store_alias",
    "baseline_policy",
    "execution_enabled"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
