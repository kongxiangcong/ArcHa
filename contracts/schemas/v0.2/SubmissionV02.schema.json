{
  "$defs": {
    "ArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "present",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "artifact_id",
        "status",
        "artifact_ref",
        "reason"
      ],
      "title": "ArtifactBinding",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "producer_job_id": {
          "minLength": 1,
          "title": "Producer Job Id",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "producer_job_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "level": {
          "enum": [
            "functional",
            "analytical",
            "simulation",
            "synthesis",
            "hardware"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "conditions",
        "evidence",
        "level"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unverified",
            "needs_human"
          ],
          "title": "Status",
          "type": "string"
        },
        "check": {
          "minLength": 1,
          "title": "Check",
          "type": "string"
        },
        "verified_check_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "title": "Verified Check Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "human_judgment": {
          "title": "Human Judgment",
          "type": "boolean"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limitation"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "check",
        "verified_check_ids",
        "evidence",
        "human_judgment",
        "limitation"
      ],
      "title": "Coverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "minimum": 1,
      "title": "Task Revision",
      "type": "integer"
    },
    "task_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Spec Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "opc.submission.v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Submission Id",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Plan Id",
      "type": "string"
    },
    "producer_call_id": {
      "minLength": 1,
      "title": "Producer Call Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/ArtifactBinding"
      },
      "minItems": 1,
      "title": "Artifact Bindings",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "failed_checks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Failed Checks",
      "type": "array"
    },
    "environment_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "deviations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Deviations",
      "type": "array"
    },
    "provides": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provides",
      "type": "array"
    },
    "affects": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affects",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "task_id",
    "task_revision",
    "task_spec_sha256",
    "run_id",
    "schema_version",
    "submission_id",
    "attempt_id",
    "plan_id",
    "producer_call_id",
    "manifest_sha256",
    "artifacts",
    "artifact_bindings",
    "claims",
    "limitations",
    "failed_checks",
    "environment_ref",
    "coverage",
    "deviations",
    "provides",
    "affects"
  ],
  "title": "SubmissionV02",
  "type": "object"
}
