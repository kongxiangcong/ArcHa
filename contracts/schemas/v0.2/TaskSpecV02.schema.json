        "network_allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "publish": {
          "const": false,
          "default": false,
          "title": "Publish",
          "type": "boolean"
        },
        "modify_harness": {
          "const": false,
          "default": false,
          "title": "Modify Harness",
          "type": "boolean"
        }
      },
      "required": [
        "readable_roots",
        "writable_roots",
        "frozen_refs",
        "allowed_tools",
        "network",
        "network_allowlist"
