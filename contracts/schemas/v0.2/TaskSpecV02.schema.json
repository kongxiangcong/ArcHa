    "Observable": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Check Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "verification": {
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "requirement_ids",
        "observation",
        "verification"
      ],
      "title": "Observable",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "readable_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Readable Roots",
          "type": "array"
        },
        "writable_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Writable Roots",
          "type": "array"
