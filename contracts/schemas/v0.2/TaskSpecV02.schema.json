  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "opc.taskspec.v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "component_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Component Id",
      "type": "string"
    },
    "task_id": {
