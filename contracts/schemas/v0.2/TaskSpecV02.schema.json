    },
    "domain": {
      "additionalProperties": true,
      "title": "Domain",
      "type": "object"
    },
    "baseline": {
      "$ref": "#/$defs/Baseline"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
