        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
