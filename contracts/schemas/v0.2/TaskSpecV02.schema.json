    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "current_state": {
          "minLength": 1,
          "title": "Current State",
          "type": "string"
        },
        "target_state": {
          "minLength": 1,
          "title": "Target State",
          "type": "string"
        },
        "negative_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Negative Constraints",
          "type": "array"
        },
        "category": {
          "enum": [
            "functional",
            "performance",
            "research",
            "reproducibility",
            "integration"
          ],
          "title": "Category",
          "type": "string"
        },
        "priority": {
          "enum": [
            "must",
            "should"
          ],
          "title": "Priority",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "success_criterion": {
          "minLength": 1,
          "title": "Success Criterion",
          "type": "string"
        },
        "verification_mode": {
          "enum": [
            "automated",
            "independent_review",
            "human_judgment"
          ],
          "title": "Verification Mode",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "statement",
        "current_state",
        "target_state",
        "negative_constraints",
        "category",
        "priority",
        "source_refs",
        "success_criterion",
        "verification_mode"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
