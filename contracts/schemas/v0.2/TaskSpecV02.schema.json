        "$ref": "#/$defs/SourceRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "research_unknowns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Research Unknowns",
      "type": "array"
    },
    "open_decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Open Decisions",
      "type": "array"
    },
    "acceptance": {
      "$ref": "#/$defs/Acceptance"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "stop_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Stop Rules",
      "type": "array"
