{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "producer_job_id": {
          "minLength": 1,
          "title": "Producer Job Id",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "producer_job_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "minimum": 1,
      "title": "Task Revision",
      "type": "integer"
    },
    "task_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Spec Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "opc.plan.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "parent_submission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Submission Id"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "hypothesis": {
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "competing_explanation": {
      "minLength": 1,
      "title": "Competing Explanation",
      "type": "string"
    },
    "change": {
      "minLength": 1,
      "title": "Change",
      "type": "string"
    },
    "controlled_variables": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Controlled Variables",
      "type": "array"
    },
    "falsification": {
      "minLength": 1,
      "title": "Falsification",
      "type": "string"
    },
    "measurement_commands": {
      "items": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "minItems": 1,
      "title": "Measurement Commands",
      "type": "array"
    },
    "expected_artifacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Artifacts",
      "type": "array"
    },
    "predicted_model_usd_upper_bound": {
      "minimum": 0,
      "title": "Predicted Model Usd Upper Bound",
      "type": "number"
    },
    "predicted_wall_seconds": {
      "minimum": 1,
      "title": "Predicted Wall Seconds",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "task_revision",
    "task_spec_sha256",
    "schema_version",
    "plan_id",
    "parent_submission_id",
    "evidence_refs",
    "hypothesis",
    "competing_explanation",
    "change",
    "controlled_variables",
    "falsification",
    "measurement_commands",
    "expected_artifacts",
    "predicted_model_usd_upper_bound",
    "predicted_wall_seconds"
  ],
  "title": "ExperimentPlan",
  "type": "object"
}
