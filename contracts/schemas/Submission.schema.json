{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "producer_job_id": {
          "minLength": 1,
          "title": "Producer Job Id",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "producer_job_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "level": {
          "enum": [
            "functional",
            "analytical",
            "simulation",
            "synthesis",
            "hardware"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "conditions",
        "evidence",
        "level"
      ],
      "title": "Claim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "minimum": 1,
      "title": "Task Revision",
      "type": "integer"
    },
    "task_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Spec Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "opc.submission.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "producer_call_id": {
      "minLength": 1,
      "title": "Producer Call Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "failed_checks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Failed Checks",
      "type": "array"
    },
    "environment_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "task_id",
    "task_revision",
    "task_spec_sha256",
    "schema_version",
    "submission_id",
    "attempt_id",
    "plan_id",
    "producer_call_id",
    "manifest_sha256",
    "artifacts",
    "claims",
    "limitations",
    "failed_checks",
    "environment_ref"
  ],
  "title": "Submission",
  "type": "object"
}
