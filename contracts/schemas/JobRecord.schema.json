{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "producer_job_id": {
          "minLength": 1,
          "title": "Producer Job Id",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "producer_job_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "minimum": 1,
      "title": "Task Revision",
      "type": "integer"
    },
    "task_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Spec Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "opc.job.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "expert",
        "designer",
        "experiment",
        "reviewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "state": {
      "enum": [
        "intent",
        "submitted",
        "running",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "backend_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Backend Job Id"
    },
    "runtime_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Runtime Call Id"
    },
    "reserved_model_usd": {
      "minimum": 0,
      "title": "Reserved Model Usd",
      "type": "number"
    },
    "actual_model_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actual Model Usd"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reconcile_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reconcile Note"
    }
  },
  "required": [
    "task_id",
    "task_revision",
    "task_spec_sha256",
    "schema_version",
    "job_id",
    "attempt_id",
    "role",
    "idempotency_key",
    "input_digest",
    "state",
    "backend_job_id",
    "runtime_call_id",
    "reserved_model_usd",
    "actual_model_usd",
    "result",
    "reconcile_note"
  ],
  "title": "JobRecord",
  "type": "object"
}
