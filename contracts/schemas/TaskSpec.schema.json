{
  "$defs": {
    "Acceptance": {
      "additionalProperties": false,
      "properties": {
        "evaluator": {
          "$ref": "#/$defs/SourceRef"
        },
        "workloads": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Workloads",
          "type": "array"
        },
        "hard_gates": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Hard Gates",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "required_review_axes": {
          "items": {
            "enum": [
              "standards",
              "spec"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Required Review Axes",
          "type": "array"
        },
        "accept_conditional": {
          "title": "Accept Conditional",
          "type": "boolean"
        },
        "evidence_ceiling": {
          "enum": [
            "functional",
            "analytical",
            "simulation",
            "synthesis",
            "hardware"
          ],
          "title": "Evidence Ceiling",
          "type": "string"
        }
      },
      "required": [
        "evaluator",
        "workloads",
        "hard_gates",
        "metrics",
        "required_review_axes",
        "accept_conditional",
        "evidence_ceiling"
      ],
      "title": "Acceptance",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_review_calls": {
          "minimum": 1,
          "title": "Max Review Calls",
          "type": "integer"
        },
        "max_wall_seconds": {
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "model_usd_cap": {
          "minimum": 0,
          "title": "Model Usd Cap",
          "type": "number"
        },
        "model_tokens_cap": {
          "minimum": 0,
          "title": "Model Tokens Cap",
          "type": "integer"
        },
        "max_concurrent_jobs": {
          "minimum": 1,
          "title": "Max Concurrent Jobs",
          "type": "integer"
        },
        "unknown_price_policy": {
          "const": "block",
          "default": "block",
          "title": "Unknown Price Policy",
          "type": "string"
        },
        "inflight_at_limit": {
          "enum": [
            "drain",
            "cancel_request"
          ],
          "title": "Inflight At Limit",
          "type": "string"
        }
      },
      "required": [
        "max_attempts",
        "max_review_calls",
        "max_wall_seconds",
        "model_usd_cap",
        "model_tokens_cap",
        "max_concurrent_jobs",
        "inflight_at_limit"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize",
            "informational"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "functional",
            "analytical",
            "simulation",
            "synthesis",
            "hardware"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "aggregation": {
          "minLength": 1,
          "title": "Aggregation",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "metric_id",
        "unit",
        "direction",
        "evidence_level",
        "aggregation",
        "target"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "readable_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Readable Roots",
          "type": "array"
        },
        "writable_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Writable Roots",
          "type": "array"
        },
        "frozen_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Frozen Refs",
          "type": "array"
        },
        "allowed_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Tools",
          "type": "array"
        },
        "network": {
          "enum": [
            "disabled",
            "allowlist"
          ],
          "title": "Network",
          "type": "string"
        },
        "network_allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "publish": {
          "const": false,
          "default": false,
          "title": "Publish",
          "type": "boolean"
        },
        "modify_harness": {
          "const": false,
          "default": false,
          "title": "Modify Harness",
          "type": "boolean"
        }
      },
      "required": [
        "readable_roots",
        "writable_roots",
        "frozen_refs",
        "allowed_tools",
        "network",
        "network_allowlist"
      ],
      "title": "Permissions",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "locator"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "opc.taskspec.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Task Id"
    },
    "task_kind": {
      "enum": [
        "research",
        "implement",
        "optimize"
      ],
      "title": "Task Kind",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "source_requirements": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Source Requirements",
      "type": "array"
    },
    "scope_in": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope In",
      "type": "array"
    },
    "scope_out": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope Out",
      "type": "array"
    },
    "deliverables": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Deliverables",
      "type": "array"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "research_unknowns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Research Unknowns",
      "type": "array"
    },
    "open_decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Open Decisions",
      "type": "array"
    },
    "acceptance": {
      "$ref": "#/$defs/Acceptance"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "stop_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Stop Rules",
      "type": "array"
    },
    "authorization_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Ref"
    },
    "domain": {
      "additionalProperties": true,
      "title": "Domain",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "parent_task_id",
    "task_kind",
    "objective",
    "source_requirements",
    "scope_in",
    "scope_out",
    "deliverables",
    "inputs",
    "research_unknowns",
    "open_decisions",
    "acceptance",
    "budget",
    "permissions",
    "stop_rules",
    "authorization_ref",
    "domain"
  ],
  "title": "TaskSpec",
  "type": "object"
}
